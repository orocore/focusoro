# Maintainer: Focusoro <noreply@focusoro.com>
# Generated by the release workflow from packaging/aur/PKGBUILD.in.
pkgname=focusoro-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Pomodoro sessions, focus tracking and goals in your terminal"
arch=('x86_64' 'aarch64')
url="https://focusoro.com"
license=('LicenseRef-Focusoro')
provides=('focusoro')
conflicts=('focusoro')
depends=('glibc')
optdepends=('libnotify: desktop notifications'
            'xdg-utils: open the HTML report and the exports folder')
source=("LICENSE-${pkgver}::https://raw.githubusercontent.com/orocore/focusoro/v${pkgver}/LICENSE"
        "THIRD-PARTY-NOTICES-${pkgver}::https://raw.githubusercontent.com/orocore/focusoro/v${pkgver}/THIRD-PARTY-NOTICES")
sha256sums=('@SHA_LICENSE@'
            '@SHA_NOTICES@')
source_x86_64=("focusoro-${pkgver}-x86_64::https://github.com/orocore/focusoro/releases/download/v${pkgver}/focusoro-linux-x86_64")
source_aarch64=("focusoro-${pkgver}-aarch64::https://github.com/orocore/focusoro/releases/download/v${pkgver}/focusoro-linux-arm64")
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')
options=('!strip' '!debug')

package() {
  install -Dm755 "focusoro-${pkgver}-${CARCH}" "${pkgdir}/usr/bin/focusoro"
  install -Dm644 "LICENSE-${pkgver}" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "THIRD-PARTY-NOTICES-${pkgver}" \
    "${pkgdir}/usr/share/licenses/${pkgname}/THIRD-PARTY-NOTICES"
}
